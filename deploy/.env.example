# Copy to deploy/.env. Generate independent random values before starting.
# POSTGRES_PASSWORD must use URL-safe letters/digits (e.g. 48 hex characters).
POSTGRES_PASSWORD=replace_with_random_hex
SESSION_SECRET=replace_with_independent_random_64_hex_characters
ADMIN_INITIAL_PASSWORD=replace_with_initial_admin_password
# Public deployment: real domain without scheme + matching HTTPS origin.
APP_DOMAIN=skz.example.org
APP_ORIGIN=http://localhost:8080
